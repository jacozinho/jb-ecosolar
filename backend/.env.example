PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jb_ecosolar
# Use false apenas em PostgreSQL local; em produção use true.
DATABASE_SSL=true
CORS_ORIGIN=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-segura
# WhatsApp Cloud API. Use o numero destinatario no formato internacional, apenas digitos.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=seu-token-da-meta
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-da-meta
WHATSAPP_RECIPIENT_PHONE=5511999999999
WHATSAPP_WEBHOOK_VERIFY_TOKEN=defina-um-token-aleatorio
WHATSAPP_APP_SECRET=app-secret-da-meta
